# ============================================================================
# evolve-studio environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` (gitignored) and fill in real values.
# In production, set the same keys in Vercel: Project → Settings → Environment.
#
# "Reuse from" notes assume Henry's existing project structure. If a key isn't
# in the listed file, sign up at the linked service.
# ============================================================================

# ---------- existing keys (already wired in current evolve-studio) ----------
ADMIN_USER=
ADMIN_PASS_HASH=                         # bcrypt hash; generate with `node -e "console.log(require('bcryptjs').hashSync('yourpassword',10))"`
JWT_SECRET=                              # any 32+ char random string
STRIPE_SECRET_KEY=                       # already in evolve-studio/.env

# ---------- Supabase (replaces Neon DATABASE_URL) ----------
# After you resolve the Free-tier blocker and create the evolve-studio project:
#   Project Settings → API → URL + service_role key
#   Project Settings → Database → Connection string (Direct)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=                            # postgres://... (Direct, not pooler), only used by scripts/setup-db.js

# ---------- Anthropic (rating + script generation) ----------
# Reuse from: console.anthropic.com if you have one for any other project,
# OR your Claude Code's ANTHROPIC_API_KEY (check `printenv ANTHROPIC_API_KEY`).
# If neither, sign up at console.anthropic.com → API Keys → set up billing.
ANTHROPIC_API_KEY=

# ---------- Apify (Google Maps lead discovery) ----------
# Reuse from: ~/IdeaProjects/Hcontentagent/.env  (var name: APIFY_API_TOKEN)
APIFY_API_TOKEN=

# ---------- Firecrawl (homepage scrape + screenshot) ----------
# You have the Firecrawl skill wired in Claude Code, but the API key for the
# server-side wrapper lives separately. Get one at firecrawl.dev (free tier 500/mo).
FIRECRAWL_API_KEY=

# ---------- Google PageSpeed Insights (Lighthouse scores) ----------
# Optional but raises rate limit from 25k to 25M/day.
# console.cloud.google.com → APIs & Services → enable "PageSpeed Insights API" → create key.
GOOGLE_PSI_API_KEY=

# ---------- Apollo.io (decision-maker phone + email enrichment) ----------
# Reuse from: your existing Apollo MCP setup. The MCP token IS the API key.
# Find it at app.apollo.io → Settings → Integrations → API. Confirm your plan
# includes phone exports, some tiers strip them.
APOLLO_API_KEY=

# ---------- Resend (Henry-facing notification emails) ----------
# Reuse from: ~/IdeaProjects/DialedbyH/.env if present (var name: RESEND_API_KEY).
# Otherwise resend.com → API Keys.
RESEND_API_KEY=
NOTIFY_EMAIL=dialedbyh@gmail.com         # where booked-meeting alerts go

# ---------- Twilio (phone number + outbound calling carrier) ----------
# Sign up at twilio.com, buy a US local number ($1.15/mo), start CNAM
# registration immediately, it takes 7-10 days to display "Evolve Studio".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=                     # +1XXXYYYZZZZ format

# ---------- Voice provider switch ----------
# "elevenlabs" (default) or "retell". Flip between providers without code changes.
# Set on Vercel to enable Retell in production; unset locally to default back to EL.
VOICE_PROVIDER=elevenlabs

# ---------- ElevenLabs (Conversational AI voice agent) ----------
# elevenlabs.io → tier with Conversational AI ($22+/mo Creator).
# AGENT_ID is created by `node scripts/seed-agent.js` (Phase 4).
# AGENT_PHONE_NUMBER_ID is the Twilio number linked inside ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=               # for HMAC verification on /api/webhooks/elevenlabs
EL_TOOL_SECRET=                          # bearer token EL sends when calling our /api/tools/* endpoints (book-meeting, opt-out, send-followup). Generate with: openssl rand -hex 32

# ---------- Retell AI (alternative voice agent — lower latency, more human) ----------
# retellai.com → API Keys. AGENT_ID + LLM_ID come from `npm run seed:retell`.
# RETELL_FROM_NUMBER = your Twilio number after importing into Retell dashboard.
# Defaults to TWILIO_PHONE_NUMBER if unset.
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_LLM_ID=
RETELL_FROM_NUMBER=                       # +1XXXYYYZZZZ, your Twilio number imported into Retell
RETELL_VOICE_ID=rime-mist-allison         # rime-mist-allison | cartesia-Sonic-Female-3 | 11labs-Elise
RETELL_LLM_MODEL=claude-4.5-haiku         # claude-4.5-haiku | gemini-2.0-flash | gpt-4o-mini

# ---------- Cal.com (Zoom booking) ----------
# cal.com → API Keys + the username/event-slug you'll use for cold-call bookings.
CAL_COM_API_KEY=
CAL_COM_EVENT_TYPE_ID=                   # numeric, find in Cal.com event-type URL
CAL_COM_WEBHOOK_SECRET=                  # generate any random string, set both here and in Cal.com webhook config
CAL_COM_PUBLIC_LINK=                     # the booking link the agent reads aloud, e.g. https://cal.com/evolvestudio/15min

# ---------- Google Sheets (Mockup Pipeline output) ----------
# Reuse from: any existing Google Sheets MCP setup. The service account
# `earnest-mark-491803-q8` is already configured in your Claude Code.
# Local dev: set the PATH var to a JSON file you've downloaded.
# Vercel/prod: set the JSON var (paste full file contents as a single-line string).
# Either one works; if both are set, JSON wins.
GOOGLE_SHEETS_CREDENTIALS_PATH=          # local file path, e.g. ./.secrets/google-sheets-sa.json
GOOGLE_SHEETS_CREDENTIALS_JSON=          # full SA credentials JSON as a string (use this in Vercel)
MOCKUP_PIPELINE_SHEET_ID=                # find in sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit

# ---------- runtime controls ----------
CRON_SECRET=                             # any random string; gates cron endpoints from public access
DIALING_ENABLED=false                    # MASTER KILL SWITCH for outbound calls. Set to "true" only when ready.
DAILY_CALL_CAP=10                        # ramp safety: starts at 10, raise to 25 → 50 → 100 over 2 weeks
